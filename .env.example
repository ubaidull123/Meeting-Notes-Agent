OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=60
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=180
MAX_UPLOAD_SIZE_MB=500
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite
# Email provider: mailgun or resend
EMAIL_PROVIDER=mailgun
# Mailgun sandbox domains can only send to recipients authorized in Mailgun.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=Meeting Notes <postmaster@your-mailgun-domain>

# Optional Resend alternative
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meeting Notes <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=
DATABASE_URL=

# LangSmith tracing (create a key at https://smith.langchain.com/)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=meeting-notes-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
